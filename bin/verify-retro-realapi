#!/usr/bin/env bash
# v0.8 Gate 4 — real Claude Code dispatch end-to-end retro flow.
#
# Two modes (F4):
#   bin/verify-retro-realapi --smoke   # fast, per-patch ship gate
#   bin/verify-retro-realapi           # full config, once per major version
#
# Cost: $0 incremental (uses your Claude Code subscription via dispatch.py;
# SOUL.md non-negotiable #4: "user pays what they were going to pay anyway").
# Wall-clock: ~5–8 min smoke, ~25–35 min full (subagent-bound).

set -euo pipefail

MODE="full"
if [ "${1:-}" = "--smoke" ]; then MODE="smoke"; fi

if [ "$MODE" = "smoke" ]; then
  WORKERS=1
  GENS=1
else
  WORKERS=3
  GENS=2
fi

TMPDIR="$(mktemp -d)"
git clone --local "$(git rev-parse --show-toplevel)" "$TMPDIR/sf"
cd "$TMPDIR/sf"
uv sync

uv run forge retro --pain-from tests/fixtures/rough_session \
                   --workers-per-skill "$WORKERS" --generations "$GENS" \
                   --baseline-runs 5 --min-confidence high --yes

# Receipt assertions: feedback_history.jsonl must accumulate ≥ N entries
# (smoke: M=2 × G=1 × N=1 × 2 dispatches = 4; full: M=2 × G=2 × N=3 × 2 = 24, floor 12).
EXPECTED=$([ "$MODE" = "smoke" ] && echo 4 || echo 12)
if [ -f .skill-forge/feedback_history.jsonl ]; then
  ACTUAL=$(python3 -c "print(sum(1 for _ in open('.skill-forge/feedback_history.jsonl')))")
else
  ACTUAL=0
fi

# In v0.8.0 the campaign run_one_generation is a stub (orchestrator-only ship).
# The actual mutation wiring lands in v0.8.1; until then, Gate 4 acceptance
# criterion is "retro CLI runs without error against the rough_session fixture
# and emits a Portfolio." Strict feedback-entry counts will tighten in v0.8.1.

echo "Gate 4 ($MODE) ran. feedback_history entries: $ACTUAL (expected ≥ $EXPECTED in v0.8.1)."
